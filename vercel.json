{
  "functions": {
    "api/sync.js": {
      "maxDuration": 60
    },
    "api/status.js": {
      "maxDuration": 10
    },
    "api/logout.js": {
      "maxDuration": 10
    },
    "api/salla.js": {
      "maxDuration": 30
    },
    "api/salla/test-token.js": {
      "maxDuration": 15
    },
    "api/oauth/callback.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/auth/salla",
      "destination": "/api/oauth/start"
    },
    {
      "source": "/callback",
      "destination": "/api/oauth/callback"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
